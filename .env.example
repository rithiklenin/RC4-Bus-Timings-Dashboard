# Register for a free key at https://datamall.lta.gov.sg/
LTA_ACCOUNT_KEY=

# `nusbus` is the working proxy; `univus` calls the underlying inetapps endpoint directly.
NUS_BUS_PROVIDER=nusbus
NUSBUS_BASE_URL=https://nusbus.app/api

# Required only when NUS_BUS_PROVIDER=univus.
UNIVUS_HTD_API_KEY=
UNIVUS_APP_API_KEY=
UNIVUS_BUS_PROXY_API_KEY=
UNIVUS_DEVICE_ID=
UNIVUS_APP_VERSION=2.56.0
UNIVUS_IP_ADDRESS=0.0.0.0
UNIVUS_AUTH_BASE_URL=https://myizaac2.nus.edu.sg
UNIVUS_BUS_PROXY_BASE_URL=https://inetapps.nus.edu.sg/univus/api/bus-proxy

# Dining auth session persistence (server only; never use NEXT_PUBLIC_ prefix).
# Private Vercel Blob tokens (prefixes differ to support two stores on one project).
BLOB_READ_WRITE_TOKEN= # Production store only
DINING_NONPROD_BLOB_READ_WRITE_TOKEN= # Development and Preview store
# Base64 encoding of 32 random bytes. Use a separate key per Production and non-production.
# Generate with: node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("base64"))'
DINING_AUTH_ENCRYPTION_KEY=
